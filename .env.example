# Template for required API keys.
# Copy this file to .env, fill in real values, and never commit .env to version control.

# Market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
POLYGON_API_KEY=your_polygon_key_here

# Social / sentiment
STOCKTWITS_ACCESS_TOKEN=your_stocktwits_token_here
STOCKGEIST_API_KEY=your_stockgeist_key_here

# News (Alpha Vantage News & Sentiment — same key as market data if using AV)
# ALPHA_VANTAGE_API_KEY already covers this if you use Alpha Vantage for news too

# Copy this file to .env and fill in real values. Never commit .env.

# Alpha Vantage — market data (intraday fallback) + news/sentiment (25 calls/day free tier)
ALPHA_VANTAGE_API_KEY=

# Polygon (unused until Phase 15 live trading — fill in when needed)
POLYGON_API_KEY=

# Finnhub — company news headlines (free tier; social-sentiment endpoint is paid-only)
FINNHUB_API_KEY=

# Notifications (primary)
DISCORD_WEBHOOK_URL=

# Notifications (secondary — critical alerts only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Notifications (tertiary — Black Swan + Red circuit breaker only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# StockTwits + Seeking Alpha Finance (via RapidAPI) — shared key, distinguished by
# x-rapidapi-host per request. Paid subscription, unlike the free-tier keys above —
# never commit or paste in plaintext outside .env.
RAPIDAPI_KEY=

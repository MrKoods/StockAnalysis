# Copy this file to .env and fill in real values. Never commit .env.

# Alpha Vantage — market data (intraday fallback) + news/sentiment (25 calls/day free tier)
ALPHA_VANTAGE_API_KEY=

# Polygon (unused until Phase 15 live trading — fill in when needed)
POLYGON_API_KEY=

# Finnhub — company news headlines (free tier; social-sentiment endpoint is paid-only)
FINNHUB_API_KEY=

# Notifications — Discord is the only delivery channel (app UI is the other, local-only)
DISCORD_WEBHOOK_URL=

# StockTwits + Seeking Alpha Finance (via RapidAPI) — shared key, distinguished by
# x-rapidapi-host per request. Paid subscription, unlike the free-tier keys above —
# never commit or paste in plaintext outside .env.
RAPIDAPI_KEY=

# SEC EDGAR — 8-K filings, no key needed (free/public), but SEC's fair-access
# policy asks for a descriptive User-Agent identifying the requester. Optional:
# works without this set, but set it to "YourName your-email@example.com".
SEC_EDGAR_USER_AGENT=

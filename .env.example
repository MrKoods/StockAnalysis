# Copy this file to .env and fill in real values. Never commit .env.

# Alpha Vantage — confirmation-only news sentiment + macro series (10y Treasury, FX,
# Fed funds, CPI). 25 calls/day free tier; the model reserves a share for the
# post-close scan (config: alpha_vantage.reserve_for_owner_scan).
ALPHA_VANTAGE_API_KEY=

# Finnhub — company news, analyst recommendation trend, insider MSPR, /stock/metric
# valuation fallback (free tier; social-sentiment / estimate endpoints are paid-only)
FINNHUB_API_KEY=

# Notifications — Discord is the only delivery channel (app UI is the other, local-only)
DISCORD_WEBHOOK_URL=

# StockTwits + Seeking Alpha Finance (via RapidAPI) — shared key, distinguished by
# x-rapidapi-host per request. Paid subscription, unlike the free-tier keys above —
# never commit or paste in plaintext outside .env.
RAPIDAPI_KEY=

# SEC EDGAR — 8-K filings, no key needed (free/public), but SEC's fair-access
# policy asks for a descriptive User-Agent identifying the requester. Optional:
# works without this set, but set it to "YourName your-email@example.com".
SEC_EDGAR_USER_AGENT=

# Anthropic — V3 deep-analysis synthesis stage only (`python -m deep_analysis`).
# Not used by the V2 scan/paper pipeline. The SDK also accepts an `ant auth
# login` profile in place of this key.
ANTHROPIC_API_KEY=

# Copy this file to .env and fill in real values. Never commit .env.

# Alpha Vantage — market data (intraday fallback) + news/sentiment (25 calls/day free tier)
ALPHA_VANTAGE_API_KEY=

# Polygon (unused until Phase 15 live trading — fill in when needed)
POLYGON_API_KEY=

# Social / sentiment
STOCKTWITS_ACCESS_TOKEN=
STOCKGEIST_API_KEY=

# Multi-source sentiment aggregator
FINNHUB_API_KEY=
ADANOS_API_KEY=
FMP_API_KEY=

# Notifications (primary)
DISCORD_WEBHOOK_URL=

# Notifications (secondary — critical alerts only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Notifications (tertiary — Black Swan + Red circuit breaker only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Reddit / PRAW
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=StockAnalysis/1.0
